# BugTraceAI v3.0.2 - baseline Low Core
BUGTRACEAI_VERSION=3.0.2
BUGTRACEAI_CONFIG=config/dvwa.json
BUGTRACEAI_CASSETTE=bt-core-2026
BUGTRACEAI_RAG_ENABLED=1
BUGTRACEAI_RAG_CACHE=1
BUGTRACEAI_RAG_MAX_DOCS=12
BUGTRACEAI_RAG_MAX_TOKENS=4500
BUGTRACEAI_RAG_DEBUG=0
BUGTRACEAI_COGNITIVE_DEBUG=1
BUGTRACEAI_MAX_ITERATIONS=500
BUGTRACEAI_PROJECT_ID=dvwa-low-validation
BUGTRACEAI_PROJECT_CYCLE=1
BUGTRACEAI_PROJECTS_DIR=projects
BUGTRACEAI_LOG_MAX_MB=250
BUGTRACEAI_LOG_RETENTION_RUNS=10
BUGTRACEAI_STORE_FULL_STDOUT=0
BUGTRACEAI_STORE_STDOUT_B64=0
BUGTRACEAI_SELF_VERDICT=1
LOG_DIR=logs
KNOWLEDGE_FILE=data/knowledge.json
TARGET_HOST=192.168.0.200
TARGET_BASE=http://192.168.0.200
BUGTRACEAI_DEBUG_RAW=0
BUGTRACEAI_MAX_ERRORS=3
BUGTRACEAI_SCHEDULER_LOOP_LIMIT=10
