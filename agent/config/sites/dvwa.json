{
  "profile": "DVWA web profile - R0-v2",
  "target": {
    "base_url": "http://192.168.0.200",
    "target_host": "192.168.0.200",
    "kali_host": "192.168.0.34",
    "kali_mcp_base": "http://192.168.0.34:9001"
  },
  "authentication": {
    "enabled": true,
    "type": "dvwa_form",
    "username": "admin",
    "password": "password",
    "security": "high",
    "login_url": "http://192.168.0.200/login.php",
    "cookie_jar": "/tmp/bugtraceai-session/dvwa_cookie.txt"
  },
  "http": {
    "user_agent": "BugTraceAI/1.9 DVWA-Lab",
    "headers": {
      "Accept": "*/*"
    },
    "timeout": 20,
    "follow_redirects": true,
    "verify_tls": false
  },
  "scheduler": {
    "autonomous": true,
    "max_mcp_commands_per_resource": 20,
    "specialized_last_attempt": true,
    "max_errors_per_resource": 20,
    "max_cycles": 500,
    "max_resource_iterations_per_analysis": 20
  },
  "reporting": {
    "run_directory": "runs",
    "formats": [
      "md",
      "html",
      "json"
    ],
    "separate_technical_log": true
  },
  "discovery": {
    "mode": "auto",
    "same_origin_only": true,
    "max_urls": 500,
    "static_resource_policy": "ignore",
    "static_extensions": [
      "css",
      "js",
      "png",
      "jpg",
      "jpeg",
      "gif",
      "svg",
      "ico",
      "woff",
      "woff2",
      "ttf",
      "map"
    ],
    "fragment_policy": "discard"
  },
  "validation_profiles": {
    "file_upload": {
      "confirmation_scope": "upload_accepted_or_same_host_retrievable",
      "response_marker": "succesfully uploaded!",
      "case_sensitive": false,
      "same_response_only": false,
      "follow_uploaded_resource": true,
      "evaluate_execution": true,
      "artifact": "assets/benign_phpinfo.php",
      "mime_type": "application/x-httpd-php"
    },
    "csp": {
      "confirmation_scope": "policy_weakness",
      "external_server_required": false,
      "allowed_probe_origins": [
        "http://127.0.0.1",
        "http://localhost",
        "http://example.invalid"
      ],
      "prefer_local_or_non_routable_probe": true,
      "execution_required": false,
      "separate_policy_weakness_from_exploitation": true
    },
    "brute_force": {
      "username": "admin",
      "password": "password",
      "must_use_fixed_credentials": true,
      "wordlist": "assets/brute.txt",
      "must_use_wordlist": false,
      "single_password_guesses_forbidden": false,
      "confirmation_scope": "credential_accepted_or_response_difference"
    },
    "csrf": {
      "username": "admin",
      "current_password": "password",
      "new_password": "password",
      "confirmation_marker": "Password Changed.",
      "restore_after_test": false,
      "preserve_operational_credentials": true
    },
    "command_injection": {
      "first_attempt_goal": "read_/etc/passwd",
      "expected_evidence_regex": "root:[^:]*:0:0:"
    },
    "lfi": {
      "first_attempt_value": "/etc/passwd",
      "expected_evidence_regex": "root:[^:]*:0:0:"
    },
    "captcha": {
      "username": "admin",
      "current_password": "password",
      "new_password": "password",
      "must_preserve_operational_credentials": true,
      "confirmation_scope": "captcha_bypass_or_password_change_response",
      "restore_after_test": false
    }
  },
  "cassette": {
    "id": "web-vulnerabilities-2026"
  },
  "adaptive_rag": {
    "enabled": true,
    "max_documents": 6,
    "max_tokens": 3200,
    "always_include_types": [
      "evidence"
    ]
  },
  "reasoner": {
    "reflection": true,
    "history_depth": 3,
    "confirm_memory_usage": true,
    "learning_trace": true
  },
  "scope": {
    "url_blacklist": [
      "/setup.php",
      "/login.php",
      "/logout.php",
      "/security.php",
      "/instructions.php",
      "/ids_log.php"
    ],
    "vulnerability_blacklist": {
      "/vulnerabilities/weak_id/": "weak_session_ids",
      "/vulnerabilities/captcha/": "captcha",
      "/vulnerabilities/xss_d/": "dom_xss",
      "/vulnerabilities/javascript/": "javascript"
    }
  }
}
